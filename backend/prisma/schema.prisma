generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUM
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  patient
  medecin
  gestionnaire
}

enum DossierStatus {
  nouveau
  formulaire_en_cours
  formulaire_complete
  en_analyse
  rapport_genere
  /// Rapport médecin mis à jour après une 1re génération (devis à recalibrer)
  rapport_modifie
  devis_preparation
  devis_envoye
  devis_accepte
  date_reservee
  logistique
  intervention
  post_op
  suivi_termine
  /// Classé sans suite : hors du fil actif, historique conservé
  abstention
}

enum FormulaireStatus {
  draft
  submitted
}

enum DevisStatut {
  brouillon
  envoye
  accepte
  refuse
}

enum RdvStatut {
  planifie
  confirme
  annule
}

enum AgendaEventType {
  rdv
  blocage
  vacances
}

enum NotifType {
  info
  warning
  success
  error
}

enum AuditAction {
  create
  update
  delete
  status_change
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & UTILISATEURS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  fullName     String   @map("full_name")
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient      Patient?
  sessions     Session[]
  messages     Message[]
  hiddenMessages MessageHidden[]
  notifications Notification[]
  agendaEvents       AgendaEvent[]
  googleCalendarSync GoogleCalendarSync?

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// PATIENT & DOSSIER
// ─────────────────────────────────────────────────────────────────────────────

model Patient {
  id             String        @id @default(uuid())
  userId         String        @unique @map("user_id")
  dossierNumber  String        @unique @map("dossier_number")
  phone          String?
  dateNaissance  DateTime?     @map("date_naissance") @db.Date
  nationalite    String?
  ville          String?
  pays           String?
  sourceContact           String?        @map("source_contact")
  status                  DossierStatus  @default(nouveau)
  /// Statut avant classement en abstention (pour réouverture)
  statusBeforeAbstention  DossierStatus? @map("status_before_abstention")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  formulaires   Formulaire[]
  files         File[]
  rapports      Rapport[]
  devis         Devis[]
  agendaEvents  AgendaEvent[]
  suiviPostOp   SuiviPostOp?
  planningSejour PlanningSejour?
  messages      Message[]

  @@map("patients")
}

// ─────────────────────────────────────────────────────────────────────────────
// FORMULAIRE MÉDICAL
// ─────────────────────────────────────────────────────────────────────────────

model Formulaire {
  id          String           @id @default(uuid())
  patientId   String           @map("patient_id")
  status      FormulaireStatus @default(draft)
  payload     Json             @default("{}")
  submittedAt DateTime?        @map("submitted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  files   File[]

  @@map("formulaires")
}

model File {
  id           String   @id @default(uuid())
  patientId    String   @map("patient_id")
  formulaireId String?  @map("formulaire_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  path         String
  createdAt    DateTime @default(now()) @map("created_at")

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  formulaire  Formulaire? @relation(fields: [formulaireId], references: [id], onDelete: SetNull)

  @@map("files")
}

// ─────────────────────────────────────────────────────────────────────────────
// RAPPORT MÉDICAL
// ─────────────────────────────────────────────────────────────────────────────

model Rapport {
  id                       String   @id @default(uuid())
  patientId                String   @map("patient_id")
  medecinId                String   @map("medecin_id")
  diagnostic               String?
  examensDemandes          String[] @default([]) @map("examens_demandes")
  interventionsRecommandees String[] @map("interventions_recommandees")
  valeurMedicale           String?  @map("valeur_medicale")
  forfaitPropose           Float?   @map("forfait_propose")
  /** Nuits préopératoires en clinique (obligatoire). */
  nuitsPreoperatoires      Int?     @map("nuits_preoperatoires")
  /** Nuits postopératoires en clinique (obligatoire, ancien champ nuits_clinique). */
  nuitsClinique            Int?     @map("nuits_clinique")
  /** Nuits hôtel prescrites par le médecin (obligatoire). */
  nuitsHotel               Int?     @map("nuits_hotel")
  /** Vêtement de contention prescrit (obligatoire). */
  vetementContention       Boolean? @map("vetement_contention")
  anesthesieGenerale       Boolean? @map("anesthesie_generale")
  /** Drainage prescrit. */
  drainage                 Boolean? @map("drainage")
  /** Nombre de séances de drainage (si drainage = oui). */
  nbSeancesDrainage        Int?     @map("nb_seances_drainage")
  /** Durée globale du séjour en Tunisie (jours). */
  dureeSejourTunisie       Int?     @map("duree_sejour_tunisie")
  /** Adultes séjour (patient + accompagnants) — repris sur le devis. */
  nbAdultesSejour          Int?     @map("nb_adultes_sejour")
  /** Enfants 2–12 ans — repris sur le devis. */
  nbEnfantsSejour          Int?     @map("nb_enfants_sejour")
  notes                    String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("rapports")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEVIS
// ─────────────────────────────────────────────────────────────────────────────

model Devis {
  id             String      @id @default(uuid())
  patientId      String      @map("patient_id")
  gestionnaireId String      @map("gestionnaire_id")
  /** Rapport médical source de cette version de devis (figé à la création). */
  rapportId      String?     @map("rapport_id")
  /** Référence affichée : MC-MM-NNN-AAAA */
  numeroDevis    String?     @unique @map("numero_devis")
  statut         DevisStatut @default(brouillon)
  version        Int         @default(1)
  lignes         Json        @default("[]")
  total          Float       @default(0)
  currency       String      @default("EUR")
  planningMedical String?    @map("planning_medical")
  notesSejour    String?     @map("notes_sejour")
  customContent  String?     @map("custom_content")
  dateValidite   DateTime?   @map("date_validite")
  dateCreation   DateTime    @default(now()) @map("date_creation")
  /** Moment d’envoi au patient (notification « devis prêt »). */
  envoyeAt       DateTime?   @map("envoye_at")
  /** Rappel automatique 72 h déjà envoyé (une seule fois). */
  rappelAutoEnvoyeAt DateTime? @map("rappel_auto_envoye_at")
  vuParPatientAt DateTime?   @map("vu_par_patient_at")
  /// Soft-delete : masqué patient + listes actives, visible dans « Devis supprimés »
  deletedAt      DateTime?   @map("deleted_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([rapportId])
  @@map("devis")
}

// ─────────────────────────────────────────────────────────────────────────────
// AGENDA MÉDECIN (RDV / blocages / vacances)
// ─────────────────────────────────────────────────────────────────────────────

model AgendaEvent {
  id             String          @id @default(uuid())
  medecinId      String          @map("medecin_id")
  type           AgendaEventType
  title          String?
  motif          String?
  dateDebut      DateTime        @map("date_debut")
  dateFin        DateTime        @map("date_fin")
  allDay         Boolean         @default(false) @map("all_day")
  patientId      String?         @map("patient_id")
  statut         RdvStatut?
  notes          String?
  googleEventId  String?         @unique @map("google_event_id")
  lastSyncedFrom String?         @map("last_synced_from")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  medecin User     @relation(fields: [medecinId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@map("agenda_events")
}

model GoogleCalendarSync {
  id               String    @id @default(uuid())
  medecinId        String    @unique @map("medecin_id")
  /** Agenda Google pour les nouveaux RDV créés dans l’app */
  googleCalendarId String    @default("primary") @map("google_calendar_id")
  /** Agendas Google cochés — synchro bidirectionnelle (import + modifications) */
  syncCalendarIds  Json?     @map("sync_calendar_ids")
  refreshToken     String    @map("refresh_token")
  accessToken      String?   @map("access_token")
  tokenExpiresAt   DateTime? @map("token_expires_at")
  lastSyncAt       DateTime? @map("last_sync_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  medecin User @relation(fields: [medecinId], references: [id], onDelete: Cascade)

  @@map("google_calendar_sync")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUIVI POST-OP
// ─────────────────────────────────────────────────────────────────────────────

model SuiviPostOp {
  id                DateTime @id @default(now()) @map("id")
  patientId         String   @unique @map("patient_id")
  dateIntervention  DateTime @map("date_intervention") @db.Date
  compteRendu       String?  @map("compte_rendu")
  photos            Json     @default("[]")
  questionnaire     Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("suivi_post_op")
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGERIE
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id              String    @id @default(uuid())
  patientId       String    @map("patient_id")
  expediteurId    String    @map("expediteur_id")
  expediteurRole  String    @map("expediteur_role")
  contenu         String
  pieceJointeUrl  String?   @map("piece_jointe_url")
  pieceJointeNom  String?   @map("piece_jointe_nom")
  lu              Boolean   @default(false)
  dateEnvoi       DateTime  @default(now()) @map("date_envoi")
  deletedForAll   Boolean   @default(false) @map("deleted_for_all")
  deletedForAllAt DateTime? @map("deleted_for_all_at")
  pinned          Boolean   @default(false)
  pinnedAt        DateTime? @map("pinned_at")
  pinnedById      String?   @map("pinned_by_id")
  /** Visible uniquement équipe (médecin / gestionnaire) — jamais la patiente. */
  staffOnly       Boolean   @default(false) @map("staff_only")
  /** Bouton « Ouvrir le dossier » — messages automatiques uniquement. */
  dossierLink     Boolean   @default(false) @map("dossier_link")

  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expediteur User            @relation(fields: [expediteurId], references: [id], onDelete: Cascade)
  hiddenBy   MessageHidden[]

  @@index([patientId, dateEnvoi])
  @@index([patientId, pinned])
  @@index([patientId, staffOnly])
  @@map("messages")
}

/** Suppression « pour moi seulement » — le message reste visible pour les autres. */
model MessageHidden {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_hidden")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  type       NotifType @default(info)
  titre      String
  message    String
  lu         Boolean   @default(false)
  lienAction String?   @map("lien_action")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT & VERSIONING
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String      @map("actor_id")
  actorRole UserRole    @map("actor_role")
  action    AuditAction
  entity    String
  entityId  String      @map("entity_id")
  before    Json?       @map("before_data")
  after     Json?       @map("after_data")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model RapportVersion {
  id        String   @id @default(uuid())
  rapportId String   @map("rapport_id")
  patientId String   @map("patient_id")
  medecinId String   @map("medecin_id")
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([rapportId, createdAt])
  @@index([patientId, createdAt])
  @@map("rapport_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOGISTIQUE
// ─────────────────────────────────────────────────────────────────────────────

model Logistique {
  id               String   @id @default(uuid())
  patientId        String   @unique @map("patient_id")
  dateArrivee      DateTime? @map("date_arrivee") @db.Date
  dateDepart       DateTime? @map("date_depart") @db.Date
  hebergement      String?
  transport        String?
  accompagnateur   String?
  notesClinique    String?  @map("notes_clinique")
  notesLogistiques String?  @map("notes_logistiques")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("logistique")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANNING SÉJOUR
// ─────────────────────────────────────────────────────────────────────────────

model PlanningSejour {
  id        String   @id @default(uuid())
  patientId String   @unique @map("patient_id")
  content   String?  @db.Text
  moisLabel String?  @map("mois_label")
  statut    String   @default("brouillon")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("planning_sejour")
}
